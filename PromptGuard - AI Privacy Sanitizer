  <script>
    (() => {
      'use strict';

      const { RULES, sanitize, countChars, countWords, estimateTokens } = PromptGuard;
      const $ = (id) => document.getElementById(id);

      const els = {
        input: $('input'),
        output: $('output'),
        outputBadge: $('outputBadge'),
        copyBtn: $('copyBtn'),
        copyLabel: $('copyLabel'),
        copyIcon: $('copyIcon'),
        checkIcon: $('checkIcon'),
        loadSample: $('loadSample'),
        clearInput: $('clearInput'),
        themeToggle: $('themeToggle'),
        enableAll: $('enableAll'),
        disableAll: $('disableAll'),
        keywordPanel: $('keywordPanel'),
        keywordInput: $('keywordInput'),
