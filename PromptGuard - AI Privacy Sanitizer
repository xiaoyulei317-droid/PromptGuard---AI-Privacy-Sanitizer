        statRedacted: $('statRedacted'),
        statBreakdown: $('statBreakdown'),
        statChars: $('statChars'),
        statCharsIn: $('statCharsIn'),
        statWords: $('statWords'),
        statWordsIn: $('statWordsIn'),
        statTokens: $('statTokens'),
        statTokensIn: $('statTokensIn'),
        toast: $('toast'),
      };
      const toggles = Array.from(document.querySelectorAll('.rule-toggle'));
      const DISPLAY_ORDER = ['email', 'phone', 'ip', 'apikey', 'keyword'];

      const SETTINGS_KEY = 'promptguard-settings';
      const THEME_KEY = 'promptguard-theme';

      // Rule switches and keyword options are remembered in this browser.
      // Your text and keyword list are never stored.
      const state = {
        rules: { email: true, phone: true, ip: true, apikey: true, keyword: true },
        keywords: [],
        caseSensitive: false,
        wholeWord: false,
      };
      let lastOutput = '';

      const SAMPLE_KEYWORDS = ['Jane Doe', 'Acme Corp', 'Project Phoenix'];
      const SAMPLE_TEXT = `Hi team,

