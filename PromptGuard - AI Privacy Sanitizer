  <!-- ==================== Sanitizer engine (pure logic, no DOM) ==================== -->
  <script>
    const PromptGuard = (() => {
      'use strict';

      /** Label and replacement tag for each rule. */
      const RULES = {
        email:   { label: 'Email',   tag: '[EMAIL_REDACTED]' },
        phone:   { label: 'Phone',   tag: '[PHONE_REDACTED]' },
        ip:      { label: 'IP',      tag: '[IP_REDACTED]' },
        apikey:  { label: 'API Key', tag: '[API_KEY_REDACTED]' },
        keyword: { label: 'Keyword', tag: '[KEYWORD_REDACTED]' },
      };

      /** Detection order. When two matches overlap, the rule listed first wins. */
      const PRIORITY = ['apikey', 'email', 'ip', 'phone', 'keyword'];

      /* ---------- API keys & tokens ---------- */
      const API_KEY_PATTERNS = [
        // OpenAI, Anthropic, OpenRouter, DeepSeek and other "sk-..." keys
        { re: /(?<![\w-])sk-(?:proj-|ant-(?:api|admin)\d{2}-|or-v1-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}/g, check: (m) => /\d/.test(m) },
        // Stripe
        { re: /(?<![\w-])(?:sk|pk|rk)_(?:live|test)_[A-Za-z0-9]{16,}/g },
        // AWS access key IDs
        { re: /(?<![A-Za-z0-9])(?:AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}(?![A-Za-z0-9])/g },
        // Google API keys
        { re: /(?<![\w-])AIza[0-9A-Za-z_-]{35}(?![\w-])/g },
        // GitHub (classic + fine-grained)
        { re: /(?<![\w-])gh[pousr]_[A-Za-z0-9]{30,}/g },
        { re: /(?<![\w-])github_pat_[A-Za-z0-9_]{30,}/g },
        // GitLab
        { re: /(?<![\w-])glpat-[A-Za-z0-9_-]{20,}/g },
        // Slack
        { re: /(?<![\w-])xox[abposr]-[A-Za-z0-9-]{10,}/g },
        // Hugging Face
        { re: /(?<![\w-])hf_[A-Za-z0-9]{30,}/g },
        // Groq
        { re: /(?<![\w-])gsk_[A-Za-z0-9]{40,}/g },
        // xAI
        { re: /(?<![\w-])xai-[A-Za-z0-9]{40,}/g },
        // JSON Web Tokens
        { re: /(?<![\w-])eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}/g },
        // "Authorization: Bearer <token>"
        { re: /(?<=\bBearer\s+)[A-Za-z0-9._~+\/-]{16,}=*/gi },
        // KEY=value style secrets: SECRET_KEY="...", "access_token": "...", api-key: ...
        {
          re: /(?<=(?:api[_-]?key|secret|token|access[_-]?key|private[_-]?key)[\w-]*["']?\s*[:=]\s*["']?)[A-Za-z0-9._~+\/=-]{16,}/gi,
          check: (m) => /[A-Za-z]/.test(m) && /\d/.test(m),
        },
      ];

      /* ---------- Email ---------- */
      const EMAIL_RE = /(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9-]+\.)+[A-Za-z]{2,}/g;

      /* ---------- IP addresses ---------- */
      const OCTET = '(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)';
      const IPV4_RE = new RegExp(`(?<![\\w.])${OCTET}(?:\\.${OCTET}){3}(?!\\w|\\.\\d)`, 'g');

      const H = '[0-9A-Fa-f]{1,4}';
      const IPV6_RE = new RegExp(
        '(?<![\\w:])(?:' + [
          `(?:${H}:){7}${H}`,
          `(?:${H}:){1,7}:`,
          `(?:${H}:){1,6}:${H}`,
          `(?:${H}:){1,5}(?::${H}){1,2}`,
          `(?:${H}:){1,4}(?::${H}){1,3}`,
          `(?:${H}:){1,3}(?::${H}){1,4}`,
          `(?:${H}:){1,2}(?::${H}){1,5}`,
          `${H}:(?::${H}){1,6}`,
          `:(?::${H}){1,7}`,
        ].join('|') + ')(?![\\w:]|\\.\\d)',
        'g'
      );

      // Rejects look-alikes such as C++ "Add::" or Python slices "a[1::2]".
      function isLikelyIPv6(m) {
        if (/^::[0-9a-f]{1,4}$/i.test(m)) return true; // ::1
        const groups = m.split(':').filter(Boolean);
        return groups.length >= 2 && groups.some((g) => g.length >= 3);
      }

      /* ---------- Phone numbers ---------- */
      // Broad candidate pattern; isLikelyPhone() filters out dates, versions, amounts, etc.
      const PHONE_RE = /(?<![\w+.-])(?:\+\d{1,3}[ .-]?)?(?:\(\d{2,4}\)[ .-]?)?\d{1,4}(?:[ .-]?\d{1,4}){1,5}(?![\w:-]|\.\d)/g;

      function isLikelyPhone(m) {
        const digits = m.replace(/\D/g, '');
        if (digits.length < 7 || digits.length > 15) return false;
        // Dates such as 2026-10-21 or 21.10.2026, and dotted IPv4 addresses
        if (/^\d{4}[-. ]\d{1,2}[-. ]\d{1,2}$/.test(m) || /^\d{1,2}[-. ]\d{1,2}[-. ]\d{4}$/.test(m)) return false;
        if (/^\d{1,3}(?:\.\d{1,3}){3}$/.test(m)) return false;
        // An international prefix or an area code in parentheses is a strong signal
        if (m.startsWith('+') || m.includes('(')) return true;

        const groups = m.split(/[ .-]/);
        // Unseparated digits: only accept common mobile / landline shapes
        if (groups.length === 1) return /^(?:0\d{9,10}|1[3-9]\d{9}|[2-9]\d{9})$/.test(digits);
        // Every group needs 2+ digits, except a leading "1" (e.g. 1-800-555-0199)
        if (groups.some((g, i) => g.length < 2 && !(i === 0 && g === '1'))) return false;

        const separators = m.replace(/\d/g, '');
        if (/^\.+$/.test(separators)) return groups.length >= 3; // 555.123.4567 (not 3.14159)
        if (/^ +$/.test(separators)) {
          // Space-separated: avoid tables of numbers like "1200 1350 1500"
          return digits.length >= 10 && digits.length <= 11 && groups[groups.length - 1].length >= 3;
        }
        return groups.length >= 3 || digits.length >= 9; // "5000-8000" is a range, not a phone
      }

      /* ---------- Custom keywords ---------- */
      const escapeRegExp = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

      function buildKeywordRegex(keywords, { caseSensitive = false, wholeWord = false } = {}) {
        const list = [...new Set((keywords || []).map((k) => k.trim()).filter(Boolean))]
          .sort((a, b) => b.length - a.length) // prefer the longest keyword
          .map(escapeRegExp);
        if (!list.length) return null;
        let source = `(?:${list.join('|')})`;
        if (wholeWord) source = `(?<![\\p{L}\\p{N}_])${source}(?![\\p{L}\\p{N}_])`;
        return new RegExp(source, caseSensitive ? 'gu' : 'giu');
      }

      /* ---------- Matching ---------- */
      function collect(re, text, check, out) {
        for (const m of text.matchAll(re)) {
          const value = m[0];
          if (!value || (check && !check(value))) continue;
          out.push({ start: m.index, end: m.index + value.length });
        }
        return out;
      }

      const DETECTORS = {
        apikey: (text) => {
          const out = [];
          for (const p of API_KEY_PATTERNS) collect(p.re, text, p.check, out);
          return out;
        },
        email: (text) => collect(EMAIL_RE, text, null, []),
        ip: (text) => collect(IPV6_RE, text, isLikelyIPv6, collect(IPV4_RE, text, null, [])),
        phone: (text) => collect(PHONE_RE, text, isLikelyPhone, []),
        keyword: (text, options) => {
          const re = buildKeywordRegex(options.keywords, options);
          return re ? collect(re, text, null, []) : [];
        },
      };

      /**
       * Sanitize text.
       * @param {string} text
       * @param {{rules: Object<string, boolean>, keywords?: string[], caseSensitive?: boolean, wholeWord?: boolean}} options
       * @returns {{output: string, segments: {text: string, type?: string}[], counts: Object<string, number>, total: number}}
       */
      function sanitize(text, options) {
        const rules = options.rules || {};
        const taken = new Uint8Array(text.length); // characters already claimed by a match
        const spans = [];

        for (const type of PRIORITY) {
          if (!rules[type] || !text) continue;
          for (const span of DETECTORS[type](text, options)) {
            let free = true;
            for (let i = span.start; i < span.end; i++) {
              if (taken[i]) { free = false; break; }
            }
            if (!free) continue;
            taken.fill(1, span.start, span.end);
            spans.push({ ...span, type });
          }
        }
        spans.sort((a, b) => a.start - b.start);

        const segments = [];
        const counts = {};
        let cursor = 0;
        for (const s of spans) {
          if (s.start > cursor) segments.push({ text: text.slice(cursor, s.start) });
          segments.push({ text: RULES[s.type].tag, type: s.type });
          counts[s.type] = (counts[s.type] || 0) + 1;
          cursor = s.end;
        }
        if (cursor < text.length) segments.push({ text: text.slice(cursor) });

        return {
          output: segments.map((s) => s.text).join(''),
          segments,
          counts,
          total: spans.length,
        };
      }

      /* ---------- Statistics ---------- */
      // Han, Hiragana, Katakana: written without spaces, so each character counts as a word.
      const CJK_WORD_RE = /[぀-ヿ㐀-䶿一-鿿豈-﫿]/g;
      // For token estimates, Hangul and full-width forms behave the same way.
      const CJK_TOKEN_RE = /[⺀-⿿　-ヿ㐀-䶿一-鿿가-힯豈-﫿＀-￯]/g;

      /** Unicode code points (emoji count as one). */
      function countChars(text) {
        const surrogatePairs = text.match(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g);
        return text.length - (surrogatePairs ? surrogatePairs.length : 0);
      }

      function countWords(text) {
        if (!text) return 0;
        const cjk = (text.match(CJK_WORD_RE) || []).length;
        const rest = text.replace(CJK_WORD_RE, ' ').split(/\s+/).filter((w) => /[\p{L}\p{N}]/u.test(w)).length;
        return cjk + rest;
      }

      /** Rough estimate: ~4 characters per token for Latin text, ~1 token per CJK character. */
      function estimateTokens(text) {
        if (!text) return 0;
        const cjk = (text.match(CJK_TOKEN_RE) || []).length;
        return Math.ceil(cjk + (countChars(text) - cjk) / 4);
      }

      return { RULES, sanitize, countChars, countWords, estimateTokens };
    })();
  </script>

