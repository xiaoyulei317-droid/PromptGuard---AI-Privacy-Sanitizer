      const numberFormat = new Intl.NumberFormat('en-US');
      const fmt = (n) => numberFormat.format(n);
      const escapeHtml = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      /* ---------- Persistence (best effort) ---------- */
      function loadSettings() {
        try {
          const saved = JSON.parse(localStorage.getItem(SETTINGS_KEY) || 'null');
          if (!saved) return;
          if (saved.rules) {
            for (const key of Object.keys(state.rules)) {
              if (typeof saved.rules[key] === 'boolean') state.rules[key] = saved.rules[key];
            }
          }
          state.caseSensitive = !!saved.caseSensitive;
          state.wholeWord = !!saved.wholeWord;
        } catch (e) { /* storage unavailable or corrupt: use defaults */ }
      }

      function saveSettings() {
        try {
          localStorage.setItem(SETTINGS_KEY, JSON.stringify({
            rules: state.rules,
            caseSensitive: state.caseSensitive,
            wholeWord: state.wholeWord,
          }));
        } catch (e) { /* ignore */ }
      }

      /* ---------- Rendering ---------- */
      function render() {
        const text = els.input.value;
        const result = sanitize(text, state);
        lastOutput = result.output;

        if (!text) {
          els.output.innerHTML = '<span class="output-placeholder">Sanitized text will appear here as you type or paste…</span>';
        } else {
          els.output.innerHTML = result.segments.map((seg) => seg.type
            ? `<mark class="tag tag-${seg.type}" title="${RULES[seg.type].label} redacted">${escapeHtml(seg.text)}</mark>`
            : escapeHtml(seg.text)
          ).join('');
        }

        // Per-rule counters on the switches
        document.querySelectorAll('[data-count-for]').forEach((badge) => {
          badge.textContent = fmt(result.counts[badge.dataset.countFor] || 0);
        });

        // Output header badge
        els.outputBadge.classList.toggle('hidden', result.total === 0);
        els.outputBadge.textContent = `${fmt(result.total)} redacted`;
        els.copyBtn.disabled = !lastOutput;

        // Statistics
        els.statRedacted.textContent = fmt(result.total);
        const breakdown = DISPLAY_ORDER.filter((type) => result.counts[type]);
        els.statBreakdown.innerHTML = breakdown.length
          ? breakdown.map((type) => `<span class="mini-chip"><span class="dot dot-${type}"></span>${fmt(result.counts[type])} ${RULES[type].label}</span>`).join('')
          : '<span class="text-slate-400 dark:text-slate-500">No sensitive items found yet</span>';

        els.statChars.textContent = fmt(countChars(lastOutput));
        els.statCharsIn.textContent = fmt(countChars(text));
        els.statWords.textContent = fmt(countWords(lastOutput));
        els.statWordsIn.textContent = fmt(countWords(text));
        els.statTokens.textContent = fmt(estimateTokens(lastOutput));
        els.statTokensIn.textContent = fmt(estimateTokens(text));
      }

      let renderQueued = false;
      function scheduleRender() {
        if (renderQueued) return;
        renderQueued = true;
        requestAnimationFrame(() => { renderQueued = false; render(); });
      }

      function syncControls() {
        toggles.forEach((btn) => btn.setAttribute('aria-checked', String(!!state.rules[btn.dataset.rule])));
        els.keywordPanel.classList.toggle('is-disabled', !state.rules.keyword);
        els.kwCase.checked = state.caseSensitive;
        els.kwWhole.checked = state.wholeWord;
      }

      function renderChips() {
        if (!state.keywords.length) {
          els.keywordChips.innerHTML = '<span class="text-xs text-slate-400 dark:text-slate-500">No custom keywords yet.</span>';
          return;
        }
        els.keywordChips.innerHTML = state.keywords.map((kw, i) => `
          <span class="kw-chip" title="${escapeHtml(kw)}">
            <span class="kw-text">${escapeHtml(kw)}</span>
            <button type="button" data-remove="${i}" aria-label="Remove keyword ${escapeHtml(kw)}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
          </span>`).join('');
      }

      /* ---------- Toast ---------- */
      let toastTimer = null;
      function showToast(message) {
        els.toast.textContent = message;
        els.toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => els.toast.classList.remove('show'), 2200);
      }

      /* ---------- Keywords ---------- */
      function addKeywords(raw) {
        const parts = raw.split(/[,\n\r]+/).map((s) => s.trim()).filter(Boolean);
        let added = 0;
        for (const part of parts) {
          if (!state.keywords.includes(part)) {
            state.keywords.push(part);
            added++;
          }
        }
        if (added) {
          renderChips();
          render();
        }
        return added;
      }

      function commitKeywordInput() {
        const value = els.keywordInput.value;
        if (!value.trim()) return;
        addKeywords(value);
        els.keywordInput.value = '';
        if (!state.rules.keyword) {
          state.rules.keyword = true;
          syncControls();
          saveSettings();
          render();
        }
      }

      els.addKeyword.addEventListener('click', () => {
        commitKeywordInput();
        els.keywordInput.focus();
      });

      els.keywordInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ',') {
          e.preventDefault();
          commitKeywordInput();
        } else if (e.key === 'Backspace' && !els.keywordInput.value && state.keywords.length) {
          state.keywords.pop();
          renderChips();
          render();
        }
      });

      els.keywordInput.addEventListener('paste', (e) => {
        const pasted = (e.clipboardData || window.clipboardData).getData('text');
        if (/[,\n\r]/.test(pasted)) {
          e.preventDefault();
          addKeywords(els.keywordInput.value + ',' + pasted);
          els.keywordInput.value = '';
        }
      });

      els.keywordChips.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-remove]');
        if (!btn) return;
        state.keywords.splice(Number(btn.dataset.remove), 1);
        renderChips();
        render();
        els.keywordInput.focus();
      });

      els.clearKeywords.addEventListener('click', () => {
        if (!state.keywords.length) return;
        state.keywords = [];
        renderChips();
        render();
        showToast('Custom keywords cleared');
      });

      els.kwCase.addEventListener('change', () => { state.caseSensitive = els.kwCase.checked; saveSettings(); render(); });
      els.kwWhole.addEventListener('change', () => { state.wholeWord = els.kwWhole.checked; saveSettings(); render(); });

      /* ---------- Rule switches ---------- */
      toggles.forEach((btn) => btn.addEventListener('click', () => {
        const rule = btn.dataset.rule;
        state.rules[rule] = !state.rules[rule];
        syncControls();
        saveSettings();
        render();
      }));

      function setAllRules(on) {
        for (const key of Object.keys(state.rules)) state.rules[key] = on;
        syncControls();
        saveSettings();
        render();
      }
      els.enableAll.addEventListener('click', () => setAllRules(true));
      els.disableAll.addEventListener('click', () => setAllRules(false));

      /* ---------- Input ---------- */
      els.input.addEventListener('input', scheduleRender);

      els.loadSample.addEventListener('click', () => {
        els.input.value = SAMPLE_TEXT;
        const added = addKeywords(SAMPLE_KEYWORDS.join(','));
        if (!state.rules.keyword && added) state.rules.keyword = true;
        syncControls();
        render();
        els.input.scrollTop = 0;
        showToast(added ? 'Sample loaded with example keywords' : 'Sample text loaded');
      });

      els.clearInput.addEventListener('click', () => {
        els.input.value = '';
        render();
        els.input.focus();
      });

      // Drop a text file onto the input box (and never let a dropped file navigate away)
      ['dragover', 'drop'].forEach((type) => window.addEventListener(type, (e) => e.preventDefault()));
      els.input.addEventListener('dragenter', () => els.input.classList.add('drag-over'));
      els.input.addEventListener('dragleave', () => els.input.classList.remove('drag-over'));
      els.input.addEventListener('drop', (e) => {
        els.input.classList.remove('drag-over');
        const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
        if (file) {
          if (file.size > 5 * 1024 * 1024) { showToast('File is too large (max 5 MB)'); return; }
          file.text().then((content) => {
            els.input.value = content;
            render();
            showToast(`Loaded ${file.name}`);
          }).catch(() => showToast('Could not read that file'));
          return;
        }
        const dropped = e.dataTransfer && e.dataTransfer.getData('text');
        if (dropped) {
          els.input.setRangeText(dropped, els.input.selectionStart, els.input.selectionEnd, 'end');
          render();
        }
      });

      /* ---------- Copy to clipboard ---------- */
      function legacyCopy(text) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '0';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        return ok;
      }

      let copyResetTimer = null;
      els.copyBtn.addEventListener('click', async () => {
        if (!lastOutput) return;
        let ok = false;
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(lastOutput);
            ok = true;
          }
        } catch (e) { ok = false; }
        if (!ok) ok = legacyCopy(lastOutput);

        if (!ok) {
          showToast('Copy failed: select the output and press Ctrl+C');
          return;
        }
        els.copyLabel.textContent = 'Copied!';
        els.copyIcon.classList.add('hidden');
        els.checkIcon.classList.remove('hidden');
        clearTimeout(copyResetTimer);
        copyResetTimer = setTimeout(() => {
          els.copyLabel.textContent = 'Copy to Clipboard';
          els.copyIcon.classList.remove('hidden');
          els.checkIcon.classList.add('hidden');
        }, 1600);
        showToast(`Copied ${fmt(countChars(lastOutput))} characters to clipboard`);
      });

      /* ---------- Theme ---------- */
      function applyTheme(dark) {
        document.documentElement.classList.toggle('dark', dark);
        els.themeToggle.setAttribute('aria-pressed', String(dark));
      }

      els.themeToggle.addEventListener('click', () => {
        const dark = !document.documentElement.classList.contains('dark');
        applyTheme(dark);
        try { localStorage.setItem(THEME_KEY, dark ? 'dark' : 'light'); } catch (e) { /* ignore */ }
      });

      // Follow the OS theme until the user picks one explicitly
      if (window.matchMedia) {
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const onSystemChange = (e) => {
          let saved = null;
          try { saved = localStorage.getItem(THEME_KEY); } catch (err) { /* ignore */ }
          if (!saved) applyTheme(e.matches);
        };
        if (media.addEventListener) media.addEventListener('change', onSystemChange);
        else if (media.addListener) media.addListener(onSystemChange);
      }

      /* ---------- Init ---------- */
      loadSettings();
      applyTheme(document.documentElement.classList.contains('dark'));
      syncControls();
      renderChips();
      render();
    })();
  </script>
</body>
</html>
