<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PromptGuard - AI Privacy Sanitizer</title>
  <meta name="description" content="Remove emails, phone numbers, IP addresses, API keys and custom keywords from text before sharing it with an AI. Runs entirely in your browser." />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🛡️</text></svg>" />

  <!-- Apply the saved (or system) theme before first paint to avoid a flash -->
  <script>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('promptguard-theme'); } catch (e) {}
      var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (saved === 'dark' || (!saved && prefersDark)) document.documentElement.classList.add('dark');
    })();
  </script>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'sans-serif'],
            mono: ['JetBrains Mono', 'ui-monospace', 'SFMono-Regular', 'Cascadia Code', 'Consolas', 'Menlo', 'monospace'],
          },
        },
      },
    };
  </script>

  <style>
    :root { color-scheme: light; }
    html.dark { color-scheme: dark; }

    /* ---------- Rule colors ---------- */
    [data-rule="email"],   .dot-email,   .tag-email   { --rule: #3b82f6; }
    [data-rule="phone"],   .dot-phone,   .tag-phone   { --rule: #10b981; }
    [data-rule="ip"],      .dot-ip,      .tag-ip      { --rule: #f59e0b; }
    [data-rule="apikey"],  .dot-apikey,  .tag-apikey  { --rule: #f43f5e; }
    [data-rule="keyword"], .dot-keyword, .tag-keyword { --rule: #8b5cf6; }

    .dot {
      display: inline-block;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 9999px;
      background: var(--rule, #94a3b8);
      flex-shrink: 0;
    }

    /* ---------- Rule toggle switches ---------- */
    .switch {
      position: relative;
      width: 2rem;
      height: 1.125rem;
      flex-shrink: 0;
      border-radius: 9999px;
      background: #cbd5e1;
      transition: background-color 0.2s ease;
    }
    .dark .switch { background: #334155; }
    .knob {
      position: absolute;
      top: 2px;
      left: 2px;
      width: 0.875rem;
      height: 0.875rem;
      border-radius: 9999px;
      background: #fff;
      box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
      transition: transform 0.2s ease;
    }
    .rule-toggle[aria-checked="true"] .switch { background: var(--rule); }
    .rule-toggle[aria-checked="true"] .knob { transform: translateX(0.875rem); }
    .rule-toggle[aria-checked="true"] {
      border-color: color-mix(in srgb, var(--rule) 55%, transparent);
      background-color: color-mix(in srgb, var(--rule) 7%, transparent);
    }
    .rule-toggle[aria-checked="false"] .rule-text { opacity: 0.55; }

    .count-badge {
      min-width: 1.6rem;
      padding: 0.1rem 0.45rem;
      border-radius: 9999px;
      font-size: 0.7rem;
      font-weight: 600;
      text-align: center;
      font-variant-numeric: tabular-nums;
      color: var(--rule);
      background: color-mix(in srgb, var(--rule) 14%, transparent);
    }

    /* ---------- Redaction tags in the output ---------- */
    mark.tag {
      border-radius: 0.3rem;
      padding: 0.05rem 0.25rem;
      font-weight: 600;
      background: color-mix(in srgb, var(--rule) 15%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rule) 30%, transparent);
    }
    .tag-email   { color: #1d4ed8; }
    .tag-phone   { color: #047857; }
    .tag-ip      { color: #b45309; }
    .tag-apikey  { color: #be123c; }
    .tag-keyword { color: #6d28d9; }
    .dark .tag-email   { color: #93c5fd; }
    .dark .tag-phone   { color: #6ee7b7; }
    .dark .tag-ip      { color: #fcd34d; }
    .dark .tag-apikey  { color: #fda4af; }
    .dark .tag-keyword { color: #c4b5fd; }

    .output-placeholder {
      color: #94a3b8;
      font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    }
    .dark .output-placeholder { color: #64748b; }

    /* ---------- Breakdown chips under "Items Redacted" ---------- */
    .mini-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.15rem 0.5rem;
      border-radius: 9999px;
      font-weight: 500;
      color: #475569;
      background: #f1f5f9;
    }
    .dark .mini-chip { color: #cbd5e1; background: #1e293b; }

    /* ---------- Custom keyword chips ---------- */
    .kw-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      max-width: 100%;
      padding: 0.2rem 0.3rem 0.2rem 0.65rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 500;
      color: #5b21b6;
      background: #ede9fe;
    }
    .dark .kw-chip { color: #ddd6fe; background: rgb(139 92 246 / 0.2); }
    .kw-chip .kw-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .kw-chip button {
      display: grid;
      place-items: center;
      width: 1.15rem;
      height: 1.15rem;
      flex-shrink: 0;
      border-radius: 9999px;
      color: inherit;
      opacity: 0.7;
    }
    .kw-chip button:hover { opacity: 1; background: rgb(139 92 246 / 0.2); }
    .kw-chip button:focus-visible { outline: 2px solid #8b5cf6; outline-offset: 1px; }
    #keywordPanel.is-disabled { opacity: 0.55; }

    /* ---------- Toast ---------- */
    .toast {
      position: fixed;
      left: 50%;
      bottom: 1.5rem;
      z-index: 50;
      max-width: calc(100vw - 2rem);
      transform: translate(-50%, 1rem);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .toast.show { opacity: 1; transform: translate(-50%, 0); }

    /* ---------- Thin scrollbars for the editors ---------- */
    .scroll-thin { scrollbar-width: thin; scrollbar-color: rgb(148 163 184 / 0.5) transparent; }
    .scroll-thin::-webkit-scrollbar { width: 10px; height: 10px; }
    .scroll-thin::-webkit-scrollbar-thumb {
      border: 3px solid transparent;
      border-radius: 9999px;
      background: rgb(148 163 184 / 0.5);
      background-clip: content-box;
    }

    .drag-over { box-shadow: inset 0 0 0 2px #6366f1; }
  </style>
</head>

<body class="min-h-screen bg-slate-50 font-sans text-slate-800 antialiased transition-colors duration-200 dark:bg-slate-950 dark:text-slate-200">
  <!-- Soft background glow -->
  <div class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-80 bg-gradient-to-b from-indigo-100/70 to-transparent dark:from-indigo-950/40"></div>

  <!-- ==================== Header ==================== -->
  <header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/80 backdrop-blur dark:border-slate-800/80 dark:bg-slate-950/80">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
      <div class="flex min-w-0 items-center gap-3">
        <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white shadow-lg shadow-indigo-500/30">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
        </div>
        <div class="min-w-0">
          <h1 class="truncate text-base font-semibold tracking-tight text-slate-900 dark:text-white sm:text-lg">
            PromptGuard <span class="hidden font-normal text-slate-400 dark:text-slate-500 sm:inline">· AI Privacy Sanitizer</span>
          </h1>
          <p class="truncate text-xs text-slate-500 dark:text-slate-400">Scrub sensitive data before it reaches an LLM</p>
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <span class="hidden items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-500/20 dark:bg-emerald-500/10 dark:text-emerald-400 md:inline-flex">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          100% local · nothing is uploaded
        </span>
        <button id="themeToggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode"
          class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">
          <!-- Moon (shown in light mode) -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px] dark:hidden" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
          <!-- Sun (shown in dark mode) -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-[18px] w-[18px] dark:block" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" /><path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" /><path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl space-y-5 px-4 py-6 sm:px-6 lg:px-8">

    <!-- ==================== Detection rules ==================== -->
    <section aria-labelledby="rules-title" class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-5">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 id="rules-title" class="text-sm font-semibold text-slate-900 dark:text-white">Detection Rules</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Choose what gets replaced. The output updates in real time.</p>
        </div>
        <div class="flex items-center gap-1 text-xs">
          <button id="enableAll" type="button" class="rounded-md px-2 py-1 font-medium text-indigo-600 transition hover:bg-indigo-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:text-indigo-400 dark:hover:bg-indigo-500/10">Enable all</button>
          <button id="disableAll" type="button" class="rounded-md px-2 py-1 font-medium text-slate-500 transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:text-slate-400 dark:hover:bg-slate-800">Disable all</button>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-2 min-[440px]:grid-cols-2 md:grid-cols-3 xl:grid-cols-5">
        <button type="button" role="switch" aria-checked="true" data-rule="email"
          class="rule-toggle flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50/60 px-3 py-2.5 text-left transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:border-slate-800 dark:bg-slate-950/40">
          <span class="switch" aria-hidden="true"><span class="knob"></span></span>
          <span class="rule-text min-w-0 flex-1">
            <span class="block text-sm font-medium text-slate-900 dark:text-slate-100">Email</span>
            <span class="block truncate font-mono text-[11px] text-slate-500 dark:text-slate-400">[EMAIL_REDACTED]</span>
          </span>
          <span class="count-badge" data-count-for="email" title="Matches found">0</span>
        </button>

        <button type="button" role="switch" aria-checked="true" data-rule="phone"
          class="rule-toggle flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50/60 px-3 py-2.5 text-left transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:border-slate-800 dark:bg-slate-950/40">
          <span class="switch" aria-hidden="true"><span class="knob"></span></span>
          <span class="rule-text min-w-0 flex-1">
            <span class="block text-sm font-medium text-slate-900 dark:text-slate-100">Phone Number</span>
            <span class="block truncate font-mono text-[11px] text-slate-500 dark:text-slate-400">[PHONE_REDACTED]</span>
          </span>
          <span class="count-badge" data-count-for="phone" title="Matches found">0</span>
        </button>

        <button type="button" role="switch" aria-checked="true" data-rule="ip"
          class="rule-toggle flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50/60 px-3 py-2.5 text-left transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:border-slate-800 dark:bg-slate-950/40">
          <span class="switch" aria-hidden="true"><span class="knob"></span></span>
          <span class="rule-text min-w-0 flex-1">
            <span class="block text-sm font-medium text-slate-900 dark:text-slate-100">IP Address <span class="text-xs font-normal text-slate-400">v4 / v6</span></span>
            <span class="block truncate font-mono text-[11px] text-slate-500 dark:text-slate-400">[IP_REDACTED]</span>
          </span>
          <span class="count-badge" data-count-for="ip" title="Matches found">0</span>
        </button>

        <button type="button" role="switch" aria-checked="true" data-rule="apikey"
          class="rule-toggle flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50/60 px-3 py-2.5 text-left transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:border-slate-800 dark:bg-slate-950/40"
          title="OpenAI / Anthropic (sk-…), AWS, Google, GitHub, GitLab, Slack, Stripe, Hugging Face, Groq, xAI, JWTs, Bearer tokens and KEY=value secrets">
          <span class="switch" aria-hidden="true"><span class="knob"></span></span>
          <span class="rule-text min-w-0 flex-1">
            <span class="block text-sm font-medium text-slate-900 dark:text-slate-100">API Key / Token</span>
            <span class="block truncate font-mono text-[11px] text-slate-500 dark:text-slate-400">[API_KEY_REDACTED]</span>
          </span>
          <span class="count-badge" data-count-for="apikey" title="Matches found">0</span>
        </button>

        <button type="button" role="switch" aria-checked="true" data-rule="keyword"
          class="rule-toggle flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50/60 px-3 py-2.5 text-left transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:border-slate-800 dark:bg-slate-950/40">
          <span class="switch" aria-hidden="true"><span class="knob"></span></span>
          <span class="rule-text min-w-0 flex-1">
            <span class="block text-sm font-medium text-slate-900 dark:text-slate-100">Custom Keywords</span>
            <span class="block truncate font-mono text-[11px] text-slate-500 dark:text-slate-400">[KEYWORD_REDACTED]</span>
          </span>
          <span class="count-badge" data-count-for="keyword" title="Matches found">0</span>
        </button>
      </div>

      <!-- Custom keywords -->
      <div id="keywordPanel" class="mt-4 rounded-xl border border-dashed border-slate-300 p-3 transition-opacity dark:border-slate-700">
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
          <label for="keywordInput" class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Custom keywords
            <span class="ml-1 font-mono font-medium normal-case tracking-normal text-violet-600 dark:text-violet-400">→ [KEYWORD_REDACTED]</span>
          </label>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600 dark:text-slate-400">
            <label class="inline-flex cursor-pointer items-center gap-1.5">
              <input id="kwCase" type="checkbox" class="h-3.5 w-3.5 rounded accent-violet-600" />
              Case sensitive
            </label>
            <label class="inline-flex cursor-pointer items-center gap-1.5" title="Only match complete words. Not recommended for Chinese / Japanese text.">
              <input id="kwWhole" type="checkbox" class="h-3.5 w-3.5 rounded accent-violet-600" />
              Whole words only
            </label>
            <button id="clearKeywords" type="button" class="font-medium text-slate-500 transition hover:text-rose-600 focus:outline-none focus-visible:underline dark:text-slate-400 dark:hover:text-rose-400">Clear all</button>
          </div>
        </div>
        <div class="mt-2 flex gap-2">
          <input id="keywordInput" type="text" autocomplete="off" spellcheck="false"
            placeholder="Names, projects, secret words… press Enter to add (commas work too)"
            class="min-w-0 flex-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 transition focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500" />
          <button id="addKeyword" type="button"
            class="shrink-0 rounded-lg bg-violet-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-violet-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">Add</button>
        </div>
        <div id="keywordChips" class="mt-2 flex flex-wrap gap-1.5" aria-live="polite"></div>
      </div>
    </section>

    <!-- ==================== Editors ==================== -->
    <section class="grid gap-4 lg:grid-cols-2">
      <!-- Input -->
      <div class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-4 py-3 dark:border-slate-800">
          <div class="flex items-center gap-2">
            <span class="dot" style="--rule:#94a3b8"></span>
            <label for="input" class="text-sm font-semibold text-slate-900 dark:text-white">Input Text</label>
          </div>
          <div class="flex items-center gap-2">
            <button id="loadSample" type="button"
              class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                <path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" />
              </svg>
              Load Sample Text
            </button>
            <button id="clearInput" type="button"
              class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-rose-500/30 dark:hover:bg-rose-500/10 dark:hover:text-rose-400">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
                <path d="M3 6h18" /><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" /><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
              </svg>
              Clear
            </button>
          </div>
        </div>
        <textarea id="input" spellcheck="false" autocomplete="off"
          placeholder="Paste text that contains emails, phone numbers, IP addresses, API keys… or drop a .txt file here."
          class="scroll-thin h-80 w-full flex-1 resize-none bg-transparent p-4 font-mono text-[13px] leading-relaxed text-slate-800 placeholder:font-sans placeholder:text-slate-400 focus:outline-none dark:text-slate-200 dark:placeholder:text-slate-500 sm:h-[460px]"></textarea>
      </div>

      <!-- Output -->
      <div class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-4 py-3 dark:border-slate-800">
          <div class="flex items-center gap-2">
            <span class="dot" style="--rule:#10b981"></span>
            <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Sanitized Output</h2>
            <span id="outputBadge" class="hidden rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"></span>
          </div>
