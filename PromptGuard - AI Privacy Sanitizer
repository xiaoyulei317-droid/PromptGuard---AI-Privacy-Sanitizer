ANTHROPIC_API_KEY=sk-ant-api03-Zr8Kp2Wm5Qx9Lt4Nv7Bc1Hd6Fj3Sg0Ya-EXAMPLE
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
curl -H "Authorization: Bearer hf_aB3dE5gH7jK9mN1pQ3sT5vX7zA9cE1gI3kM5" https://api.example.com/v1/data

